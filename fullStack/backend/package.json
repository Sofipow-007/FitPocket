{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "preinstall": "node scripts/verificarNode.cjs",
    "prestart": "node scripts/prepararEnv.js",
    "start": "node index.js",
    "predev": "node scripts/prepararEnv.js",
    "dev": "nodemon index.js",
    "test": "jest",
    "test:cobertura": "jest --coverage",
    "test:perf": "node tests/perf/rendimiento.js",
    "env:abrir": "node scripts/envCifrado.js abrir",
    "env:cerrar": "node scripts/envCifrado.js cerrar"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "groq-sdk": "^1.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.3.0",
    "mongoose": "^9.4.1",
    "nodemailer": "^10.0.16"
  },
  "devDependencies": {
    "autocannon": "^8.0.0",
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.3.1"
  },
  "description": "",
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/helpers/entorno.js"
    ],
    "testTimeout": 30000,
    "collectCoverageFrom": [
      "controllers/**/*.js",
      "middleware/**/*.js",
      "services/**/*.js",
      "models/**/*.js",
      "utils/**/*.js",
      "routes/**/*.js",
      "app.js"
    ],
    "coverageReporters": [
      "text-summary",
      "text",
      "lcov"
    ]
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "config": {
    "mongodbMemoryServer": {
      "disablePostinstall": "1"
    }
  }
}
