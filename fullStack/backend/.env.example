# Obligatorias: sin estas tres el backend no arranca.
MONGODB_URI=mongodb+srv://usuario:password@cluster.mongodb.net/fitpocket
# En producción: al menos 32 caracteres, distintas entre sí y nunca estos valores de ejemplo.
# Para generar una: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=una-clave-larga-y-aleatoria
# Cifra nombre, limitaciones y aclaración. Si la cambiás, pasá los datos con scripts/recifrar.js
# (si no, los nombres guardados ya no se pueden leer).
CRYPTO_KEY=otra-clave-larga-y-aleatoria
# development (default) o production. En production se exigen FRONTEND_URL y claves largas.
NODE_ENV=development
# Proveedor de IA para generar los planes: groq (default) u ollama.
# Un valor inválido frena el arranque con un error que lista los válidos.
IA_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Solo con IA_PROVIDER=ollama (Ollama corriendo local o en otra máquina)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
OLLAMA_TIMEOUT_MS=180000
PORT=3000

# URL del front: CORS solo acepta pedidos desde acá (varias separadas por coma) y los
# mails de recuperación apuntan acá. En desarrollo también se acepta http://localhost:5173.
FRONTEND_URL=http://localhost:5173
# Recuperación de contraseña. Sin SMTP_HOST/USER/PASS el enlace se imprime en la consola del backend.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Bitácora: días que se conservan los registros (índice TTL, partición temporal)
BITACORA_TTL_DIAS=180
# Backups (node scripts/backup.js o el botón de /admin): carpeta y cuántos se conservan
BACKUP_DIR=
BACKUP_RETENCION=7
