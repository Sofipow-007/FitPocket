    {
      "parameters": {
        "jsCode": "const p = $('Webhook Registro').first().json.body.perfil;\nconst userId = $('Webhook Registro').first().json.body.userId;\n\nconst limitaciones = (p.limitaciones && p.limitaciones.length > 0)\n  ? p.limitaciones.join(', ')\n  : 'ninguna';\n\nconst prompt = `Generá un plan de fitness y nutrición para:\nPeso: ${p.peso}kg\nAltura: ${p.altura}cm\nEdad: ${p.edad} años\nSexo: ${p.sexo}\nObjetivo: ${p.objetivo}\nNivel: ${p.nivel}\nDías disponibles: ${p.diasDispo.join(', ')}\nMinutos por sesión: ${p.minutosPorSesion}\nTipo de dieta: ${p.tipoDieta}\nPresupuesto mensual: $${p.presupuesto}\nLimitaciones: ${limitaciones}\n\nEstructura JSON exacta requerida:\n{\"meta\":{\"objetivo\":\"string\",\"duracionSemanas\":number,\"caloriasObjetivoDia\":number,\"nivelDificultad\":\"string\",\"justificacion\":\"string\"},\"rutina\":[{\"dia\":\"string\",\"tipo\":\"string\",\"duracionMinutos\":number,\"ejercicios\":[{\"nombre\":\"string\",\"series\":number,\"repeticiones\":\"string\",\"descansoSegundos\":number,\"nota\":\"string\"}]}],\"dieta\":[{\"dia\":\"string\",\"desayuno\":{\"descripcion\":\"string\",\"calorias\":number},\"almuerzo\":{\"descripcion\":\"string\",\"calorias\":number},\"merienda\":{\"descripcion\":\"string\",\"calorias\":number},\"cena\":{\"descripcion\":\"string\",\"calorias\":number},\"costoEstimadoDia\":number}]}\n\nLa rutina y dieta deben tener los 7 días. Los días sin entrenamiento tienen ejercicios en [].`;\n\nconst body = {\n  model: 'llama-3.3-70b-versatile',\n  max_tokens: 4096,\n  temperature: 0.7,\n  messages: [\n    {\n      role: 'system',\n      content: 'Sos un entrenador personal y nutricionista experto. Respondés ÚNICAMENTE con JSON válido puro, sin texto adicional, sin markdown, sin bloques de código.'\n    },\n    {\n      role: 'user',\n      content: prompt\n    }\n  ]\n};\n\nreturn [{ json: { userId, groqBody: body } }];"
      },
      "id": "f76ec308-744e-4bf2-a551-d6af40dbd093",
      "name": "Armar body para Groq",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4288,
        4192
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.groq.com/openai/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.groqBody) }}",
        "options": {}
      },
      "id": "3cd107e3-a44a-4376-b47a-230a8ede8ec3",
      "name": "Groq API - Generar plan",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        4512,
        4192
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "EN4uN8pbvgT7tw4U",
          "name": "Header Auth account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const raw = $input.first().json.choices[0].message.content;\n\nconst clean = raw\n  .replace(/```json\\n?/g, '')\n  .replace(/```/g, '')\n  .trim();\n\nlet plan;\ntry {\n  plan = JSON.parse(clean);\n} catch(e) {\n  throw new Error('Groq no devolvio JSON valido: ' + clean.substring(0, 200));\n}\n\nreturn [{\n  json: {\n    ok: true,\n    plan: {\n      meta:   plan.meta,\n      rutina: plan.rutina,\n      dieta:  plan.dieta\n    }\n  }\n}];"
      },
      "id": "1b1cdb93-f109-4387-934e-1d88fe8ef406",
      "name": "Parsear respuesta Groq",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4736,
        4192
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { ok: false, error: 'Faltan campos obligatorios' } }];"
      },
